[Unit]
Description=QuantPilot scheduled market scanner
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=quantpilot
Group=quantpilot
WorkingDirectory=/home/quantpilot/app
EnvironmentFile=/etc/quantpilot/quantpilot.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=quantpilot
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock --no-fork --nonblock /run/quantpilot/scheduler.lock /home/quantpilot/venv/bin/python /home/quantpilot/app/scheduler.py
Restart=on-failure
RestartSec=15s
KillMode=control-group
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/home/quantpilot/app/database /home/quantpilot/app/logs
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
