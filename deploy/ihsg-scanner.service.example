[Unit]
Description=aerologic scheduled market scanner
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/aerologic-h1-invezgo
EnvironmentFile=/home/ubuntu/aerologic-h1-invezgo/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=aerologic-h1-invezgo
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock --no-fork --nonblock /run/aerologic-h1-invezgo/scheduler.lock /home/ubuntu/aerologic-h1-invezgo/venv/bin/python /home/ubuntu/aerologic-h1-invezgo/scheduler.py
Restart=on-failure
RestartSec=15s
KillMode=control-group
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/home/ubuntu/aerologic-h1-invezgo/database /home/ubuntu/aerologic-h1-invezgo/logs
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
