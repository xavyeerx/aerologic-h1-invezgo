[Unit]
Description=IHSG Supertrend Scanner
After=network.target

[Service]
Type=simple
User=anugrahdwikiar
WorkingDirectory=/home/anugrahdwikiar/ihsg-scanner
# Satu instance: flock di .scheduler.lock (Python lock sudah dihapus — jangan pakai .scheduler_py.lock)
ExecStartPre=-/bin/sh -c 'pkill -f "/home/anugrahdwikiar/ihsg-scanner/scheduler.py" || true; rm -f /home/anugrahdwikiar/ihsg-scanner/database/.scheduler.lock /home/anugrahdwikiar/ihsg-scanner/database/.scheduler_py.lock'
ExecStart=/usr/bin/flock -n /home/anugrahdwikiar/ihsg-scanner/database/.scheduler.lock /home/anugrahdwikiar/ihsg-scanner/venv/bin/python /home/anugrahdwikiar/ihsg-scanner/scheduler.py
ExecStopPost=-/bin/sh -c 'pkill -f "/home/anugrahdwikiar/ihsg-scanner/scheduler.py" || true; rm -f /home/anugrahdwikiar/ihsg-scanner/database/.scheduler.lock /home/anugrahdwikiar/ihsg-scanner/database/.scheduler_py.lock'
Restart=on-failure
RestartSec=15
KillMode=control-group
TimeoutStopSec=30
StandardOutput=journal
StandardError=journal
Environment=PYTHONUNBUFFERED=1

[Install]
WantedBy=multi-user.target
