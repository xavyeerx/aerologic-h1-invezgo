[Unit]
Description=QuantPilot scheduled market scanner
Wants=network-online.target
After=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
User=ubuntu
Group=ubuntu
WorkingDirectory=/home/ubuntu/quantpilotbot
EnvironmentFile=/home/ubuntu/quantpilotbot/.env
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
RuntimeDirectory=quantpilot
RuntimeDirectoryMode=0750
ExecStart=/usr/bin/flock --no-fork --nonblock /run/quantpilot/scheduler.lock /home/ubuntu/quantpilotbot/venv/bin/python /home/ubuntu/quantpilotbot/scheduler.py
Restart=on-failure
RestartSec=15s
KillMode=control-group
TimeoutStopSec=30s
StandardOutput=journal
StandardError=journal
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=full
ReadWritePaths=/home/ubuntu/quantpilotbot/database /home/ubuntu/quantpilotbot/logs
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
