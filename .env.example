# ============================================
# TEMPLATE ENV — copy jadi .env, lalu isi nilainya.
# Template ini dicopy menjadi `.env` lokal. Unit systemd bawaan membaca
# `/home/ubuntu/aerologic-h1-invezgo/.env`.
# JANGAN commit .env asli (sudah masuk .gitignore).
# ============================================

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Opsional untuk grup scanner yang memakai Topics.
# TELEGRAM_SCANNER_TOPIC_ID=699
# Tujuan terpisah untuk event startup, error, dan stop.
TELEGRAM_TEST_CHAT_ID=

# Optional backend sync. Keep disabled when the endpoint also sends Telegram.
SIGNAL_API_ENABLED=
SIGNAL_API_URL=
BACKEND_WEBHOOK_SECRET=

# --- Invezgo API ---
# Ambil / rotasi key di: https://invezgo.com/setting/api
# JANGAN pernah paste key ke chat, commit, atau file yang tersinkron.
INVEZGO_API_KEY=

# Opsional — override base URL. Default: https://api.invezgo.com/
# INVEZGO_BASE_URL=

# --- Learning (opsional, Postgres) ---
# DATABASE_URL=
# DATABASE_PUBLIC_URL=

# --- Tuning scan (opsional) ---
# SCAN_ANALYZE_WORKERS=4
# INVEZGO_FETCH_WORKERS=4
# INVEZGO_RATE_PER_SEC=3
# INVEZGO_TIMEOUT=10
# INVEZGO_MAX_RETRIES=3
# INVEZGO_BACKOFF_BASE=2
# INVEZGO_THROTTLE_RETRY_MAX=4
# INVEZGO_THROTTLE_RETRY_WAIT=5
# Set sesuai paket aktif (Advance=30000, Prime=65000).
# INVEZGO_MONTHLY_QUOTA=30000
# INVEZGO_QUOTA_WARN_PCT=90
# INVEZGO_QUOTA_BREAK_PCT=95
# NEWS_CONTEXT_ENABLED=true
# NEWS_CONTEXT_MAX_AGE_DAYS=30
# NEWS_CONTEXT_DIRECT_MAX_AGE_DAYS=7
# NEWS_CONTEXT_MAX_ITEMS_PER_GROUP=2
# NEWS_CONTEXT_WORKERS=4
# Safety floor for the pre-open screener factor
# SCREEN_VOLUME_MIN_FACTOR=0.005

# --- Daily chart-pattern review (16:30 WIB, Senin-Jumat) ---
# CHART_PATTERN_ENABLED=true
# CHART_PATTERN_UNIVERSE_LIMIT=240
# CHART_PATTERN_HISTORY_DAYS=210
# CHART_PATTERN_CACHE_BARS=160
# Maksimum history fetch saat bootstrap/repair dalam satu run.
# CHART_PATTERN_BOOTSTRAP_LIMIT=240
# CHART_PATTERN_MIN_TURNOVER=5000000000
# CHART_PATTERN_BREAK_BUFFER=0.00125
# CHART_PATTERN_TOUCH_ATR_MULT=0.60

# --- H1 production engine ---
# STRONG_BUY_MAX_CHANGE_PCT=12.0
# STRONG_BUY_STOCH_RSI_MAX=60.0
# ALERT_SL_MIN_PCT=5.0
# ALERT_SL_MAX_PCT=7.0
# REVERSAL_MAX_RETURN20=-8.0
# REVERSAL_MAX_RSI=35
# REVERSAL_MIN_VOLUME_RATIO=1.5
